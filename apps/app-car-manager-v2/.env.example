# =============================================================================
# app-car-manager-v2 — Environment template
# =============================================================================
#
# v2 ships to 3 distinct runtime targets, each with its OWN config source:
#
#   1. LOCAL DEV          → this .env file (copy to .env, fill secrets)
#   2. RENDER (cloud)     → render.yaml + Render dashboard (Environment tab)
#   3. STAGING DOCKER     → apps/app-car-manager-v2/.env on the staging server
#                            (separate file, NOT this one — server has its own)
#
# Two values intentionally DIVERGE between targets (D2 topology):
#   • BASE_PATH  — empty for local + Render (clean URL), `/app-car-manager-v2`
#                  for staging (shares domain with 4 other apps via nginx)
#   • APP_URL    — matches the user-facing host of each target
# Every other var must match byte-for-byte across targets that share state
# (JWT_SECRET, DATABASE_URL → most common failure mode = mismatch).
#
# See INTEGRATION.md §5 for the full dual-deploy diagram.
# =============================================================================


# -----------------------------------------------------------------------------
# App identity (same on all targets)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_CODE=car-manager-v2
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Space-separated list of origins allowed to iframe-embed this app
# (renders into CSP frame-ancestors header). Include EVERY platform host:
#   • Local:    http://localhost:5200 https://*.amoeba.site
#   • Staging:  https://stg-apps.amoeba.site https://stg-ama.amoeba.site
#   • Prod:     https://apps.amoeba.site https://ama.amoeba.site
NEXT_PUBLIC_AMA_ORIGIN=https://ama.amoeba.site


# -----------------------------------------------------------------------------
# Per-target divergence (CHANGE THESE TWO PER ENV — see table below)
# -----------------------------------------------------------------------------

# BASE_PATH — Next.js basePath baked in at BUILD time (inlined into JS bundle).
#
# | Target           | BASE_PATH                  | Why                          |
# |------------------|----------------------------|------------------------------|
# | Local            | (empty) ← this default     | clean URL at localhost:3001  |
# | Render           | (empty, set in render.yaml)| clean URL on *.onrender.com  |
# | Staging Docker   | /app-car-manager-v2        | shares domain with 4 apps    |
# |                  | (set in docker-compose     | behind nginx prefix          |
# |                  |  build args, NOT .env)     |                              |
BASE_PATH=

# APP_URL — canonical public origin (cookie domain + redirect target).
# MUST match the host the BROWSER sees, not the internal upstream.
#
# | Target           | APP_URL                                          |
# |------------------|--------------------------------------------------|
# | Local            | (empty — derived from x-forwarded-host or req)   |
# | Render           | https://car-manager-staging.onrender.com         |
# | Staging Docker   | https://stg-apps.amoeba.site                     |
# | Prod (future)    | https://apps.amoeba.site                         |
APP_URL=


# -----------------------------------------------------------------------------
# Auth — JWT_SECRET MUST be byte-for-byte identical across AMA + platform + v2
# -----------------------------------------------------------------------------

# HS256 secret used by ambManagement to sign JWTs and by v2 to verify them.
# Get from AMA staging container: docker exec amb-api env | grep JWT_SECRET
JWT_SECRET=replace-with-shared-secret-from-ambManagement
SESSION_COOKIE_NAME=amb_session

# DEMO_AUTO_LOGIN enables /dev-login route (mints test JWT, sets cookie).
# Local:   true   (paste-ready URLs in root .env.local)
# Render:  false  (or true only when actively debugging — DELETE after)
# Staging: false  (security: anyone hitting /dev-login can bypass auth)
DEMO_AUTO_LOGIN=false

# Optional — base URL for scripts/dev-token.mjs (mint test JWT + paste-ready URL).
# Default http://localhost:3001. Override when testing against deployed instance.
DEV_WEB_URL=


# -----------------------------------------------------------------------------
# Database — Neon Postgres (serverless, HTTP)
# -----------------------------------------------------------------------------

# Region ap-southeast-1 (Singapore), pooler endpoint. Physical DB = neondb
# (Neon default — isolation comes from table prefix + ent_id). See CLAUDE.md §4.3.
#
#   DATABASE_URL          = currently-active branch (used by `npm run db:migrate`,
#                           `db:studio`, and the running app)
#   DATABASE_URL_DEV      = dev branch (used by `npm run db:migrate:dev`)
#   DATABASE_URL_STAGING  = staging branch (used by `npm run db:migrate:staging`)
#
# Local setup: copy DEV URL into both DATABASE_URL and DATABASE_URL_DEV.
# Render + Staging: set DATABASE_URL = STAGING URL (same DB shared by both).
DATABASE_URL=postgresql://neondb_owner:<password>@<dev-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DEV=postgresql://neondb_owner:<password>@<dev-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_STAGING=postgresql://neondb_owner:<password>@<staging-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# -----------------------------------------------------------------------------
# AWS S3 — expense receipt uploads (NFR-11, retention 5y NFR-10)
# -----------------------------------------------------------------------------
# Required from Phase P2+ (expense module). Leave blank in P1.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=amb-car-manager-v2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# AMA platform reference (for cross-system API calls if needed)
# -----------------------------------------------------------------------------
APP_STORE_API_URL=https://apps.amoeba.site/api/v1


# =============================================================================
# Quick-fill templates per target
# =============================================================================

# ┌─ RENDER DASHBOARD (Environment tab) ───────────────────────────────────────
# │ Note: render.yaml already declares APP_URL + NODE_ENV. Add these as secrets
# │       (sync: false in render.yaml). Dashboard values OVERRIDE render.yaml.
# │
# │   JWT_SECRET             = <shared with AMA staging>
# │   DATABASE_URL           = <Neon STAGING pooler URL>
# │   NEXT_PUBLIC_AMA_ORIGIN = https://ama.amoeba.site https://stg-ama.amoeba.site
# │   DEMO_AUTO_LOGIN        = false  (true only when debugging)
# │   AWS_ACCESS_KEY_ID      = <leave empty until P2>
# │   AWS_SECRET_ACCESS_KEY  = <leave empty until P2>
# │
# │ ⚠️ DO NOT set BASE_PATH or APP_URL in dashboard — render.yaml handles them.
# │    If previously set, DELETE so render.yaml values apply (dashboard wins).
# └─────────────────────────────────────────────────────────────────────────────

# ┌─ STAGING SERVER (apps/app-car-manager-v2/.env on stg-apps.amoeba.site) ────
# │ Created/edited via SSH. Loaded by deploy-staging.sh into Docker container.
# │
# │   NEXT_PUBLIC_APP_CODE       = car-manager-v2
# │   NEXT_PUBLIC_AMA_ORIGIN     = https://stg-apps.amoeba.site https://stg-ama.amoeba.site
# │   NEXT_PUBLIC_DEFAULT_LOCALE = vi
# │   BASE_PATH                  = /app-car-manager-v2   ← KEEP, behind nginx prefix
# │   APP_URL                    = https://stg-apps.amoeba.site
# │   JWT_SECRET                 = <same as Render + AMA>
# │   SESSION_COOKIE_NAME        = amb_session
# │   DEMO_AUTO_LOGIN            = false
# │   DATABASE_URL               = <same Neon STAGING as Render>
# │   AWS_*                      = same as Render
# └─────────────────────────────────────────────────────────────────────────────

# ┌─ LOCAL DEV (this file copied to .env, gitignored) ─────────────────────────
# │
# │   BASE_PATH                  = (empty — clean URL at localhost:3001)
# │   APP_URL                    = (empty)
# │   JWT_SECRET                 = dev-local-jwt-secret-change-me (any string)
# │   DEMO_AUTO_LOGIN            = true (enables /dev-login)
# │   DATABASE_URL               = <Neon DEV pooler URL>
# │   NEXT_PUBLIC_AMA_ORIGIN     = http://localhost:5200 https://*.amoeba.site
# │
# │ Embedded local testing via platform :5200 still works thanks to Vite proxy
# │ rewrite — see platform/frontend/vite.config.ts. Direct :3001 = clean URL.
# └─────────────────────────────────────────────────────────────────────────────

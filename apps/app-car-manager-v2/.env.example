NEXT_PUBLIC_APP_CODE=car-manager-v2
NEXT_PUBLIC_AMA_ORIGIN=https://ama.amoeba.site
NEXT_PUBLIC_DEFAULT_LOCALE=vi

JWT_SECRET=replace-with-shared-secret-from-ambManagement
SESSION_COOKIE_NAME=amb_session

# Demo: enable /dev-login route to bypass AMA auth (role buttons on /session-expired)
# DO NOT enable on real production.
DEMO_AUTO_LOGIN=false

# Neon Postgres — free tier, region ap-southeast-1 (Singapore), pooler endpoint
# Physical DB name = neondb (Neon default). See CLAUDE.md §4.3.
DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# AWS S3 — chứng từ chi phí (NFR-11, retention 5 năm NFR-10)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=amb-car-manager-v2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AMA platform reference
APP_STORE_API_URL=https://apps.amoeba.site/api/v1

{
  "name": "app-car-manager-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Company Car Management System (CCMS) v2 — standalone Turborepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w @car-v2/web",
    "dev:cron": "node scripts/dev-cron-loop.mjs",
    "dev:full": "concurrently -k -n web,cron -c cyan,magenta \"npm run dev:web\" \"npm run dev:cron\"",
    "dev:token": "node --env-file=.env scripts/dev-token.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:push": "npm run db:push -w @car-v2/db",
    "db:generate": "npm run db:generate -w @car-v2/db",
    "db:migrate": "npm run db:migrate -w @car-v2/db",
    "db:migrate:dev": "node scripts/db-migrate.mjs dev",
    "db:migrate:staging": "node scripts/db-migrate.mjs staging",
    "db:seed:dev": "node scripts/db-seed.mjs dev",
    "db:seed:staging": "node scripts/db-seed.mjs staging",
    "db:heal:dev": "node scripts/db-heal-usr-id.mjs dev",
    "db:heal:staging": "node scripts/db-heal-usr-id.mjs staging",
    "db:studio": "npm run db:studio -w @car-v2/db",
    "cron:maintenance": "node scripts/trigger-maintenance-cron.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

NEXT_PUBLIC_APP_CODE=sales-report-v2
NEXT_PUBLIC_AMA_ORIGIN=https://ama.amoeba.site
NEXT_PUBLIC_DEFAULT_LOCALE=ko

# Phase 1 of versioned prime cost. When `on`, master loader returns versions[]
# per SKU + calculator picks the version active at the order's createDate.
# Default off — safe to flip after migration 0008 has been applied + verified.
NEXT_PUBLIC_PRIME_COST_VERSIONING=off

JWT_SECRET=replace-with-shared-secret-from-ambManagement
SESSION_COOKIE_NAME=amb_session

# Demo: enable /dev-login route to bypass AMA auth (3 role buttons on /session-expired)
# DO NOT enable on real production.
DEMO_AUTO_LOGIN=false

DATABASE_URL=postgresql://user:password@host.neon.tech/db_app_sales_v2?sslmode=require

AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=amb-sales-report-v2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=1

APP_STORE_API_URL=https://apps.amoeba.site/api/v1

# Real per-tenant user sync. When set, "Sync from AMA" on the Users page fetches
# the entity's members from ambManagement (GET /entity-settings/members),
# scoped to the caller's OWN entity via their forwarded AMA session token.
# Unset (and DEMO_AUTO_LOGIN!=true) → sync is disabled; real tenants rely on
# auto-provision at first login. Requires this app be registered in
# amb_entity_custom_apps WITHOUT a per-app JWT secret (tokens must be signed
# with the shared global JWT_SECRET).
AMA_API_BASE_URL=https://ama.amoeba.site/api/v1

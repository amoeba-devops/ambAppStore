  "help": {
    "title": "User Guide",
    "introTitle": "About this app",
    "introBody": "The Corporate Vehicle Manager handles the full lifecycle of vehicle operations — from dispatch request to trip log entry.\nTwo core workflows: ① Dispatch — request → approve → driver accept → depart → arrive → complete, and ② Trip Log — record → complete → verify.",
    "toc": "Contents",
    "navTitle": "Navigation",
    "navIntro": "Use the left sidebar to access these sections.",
    "navDispatchDesc": "Dispatch board — board view grouped by status (PENDING / APPROVED / DEPARTED / ...)",
    "navTripLogDesc": "Trip log list — monthly filter, Excel upload/download supported",
    "navVehicleDesc": "Vehicle list and detail — register, edit, change status",
    "navDriverDesc": "Driver list — register AMA users as drivers, manage role/status",
    "dispatchTitle": "Dispatch status workflow",
    "dispatchIntro": "Each dispatch follows a defined state machine from request to completion. Use action buttons in the detail page to advance.",
    "dispatchTerminalNote": "REJECTED and CANCELLED are terminal — no further changes allowed.",
    "dispatchStep1Title": "PENDING → Confirm or reject",
    "dispatchStep1Body": "Admin opens dispatch detail → [Confirm Dispatch] → select vehicle/driver in modal → APPROVED. Or [Reject] → enter reason → REJECTED (terminal).",
    "dispatchStep2Title": "APPROVED → Driver accepts",
    "dispatchStep2Body": "The assigned driver gets a notification; on accept → DRIVER_ACCEPTED. If admin uses driver-override, depart is available immediately.",
    "dispatchStep3Title": "DRIVER_ACCEPTED → Depart",
    "dispatchStep3Body": "When the trip starts, click [Depart] → DEPARTED. The vehicle status automatically changes to IN_USE.",
    "dispatchStep4Title": "DEPARTED → Arrive",
    "dispatchStep4Body": "On arrival at destination click [Arrive] → ARRIVED. Mileage/ODO is entered in the trip log.",
    "dispatchStep5Title": "ARRIVED → Complete",
    "dispatchStep5Body": "After return click [Complete] → COMPLETED. The vehicle status returns to AVAILABLE.",
    "dispatchStep6Title": "Trip Log auto-created",
    "dispatchStep6Body": "At DEPARTED, a Trip Log is auto-created for this dispatch. Fill in actual depart/arrive times, distance, etc. in the Trip Log.",
    "dispatchCancelTitle": "Cancel",
    "dispatchCancelBody": "If the dispatch is not in a terminal state (COMPLETED/CANCELLED/REJECTED) you can cancel anytime — a reason is required.",
    "openDispatchBoard": "Open Dispatch Board",
    "tripLogTitle": "Trip Log status workflow",
    "tripLogIntro": "A Trip Log is auto-created at dispatch depart. After the trip, fill in remaining fields then submit → verify.",
    "tripLogStep1Title": "IN_PROGRESS — entering data",
    "tripLogStep1Body": "Auto-created at depart. Driver/admin fills ODO, fuel amount, toll, customer, notes. Edits are free in this state.",
    "tripLogStep2Title": "IN_PROGRESS → COMPLETED (submit)",
    "tripLogStep2Body": "When entry is done, click [Submit → COMPLETED] at the bottom of the detail page. Admin will be asked to verify.",
    "tripLogStep3Title": "COMPLETED → VERIFIED",
    "tripLogStep3Body": "Admin reviews and clicks [Verify → VERIFIED]. After this the log is final and cannot be edited.",
    "tripLogStep4Title": "VOIDED — when entered incorrectly",
    "tripLogStep4Body": "While status is IN_PROGRESS or COMPLETED, you can void a trip log via the [Void] button on the detail page. After entering a reason, the action is applied immediately and cannot be undone. Voided logs are excluded from monthly statistics (distance, fuel cost), and the linked dispatch is automatically set to CANCELLED. Voiding is not allowed once the log is VERIFIED.",
    "tripLogTip": "Tip",
    "tripLogTipBody": "Use Excel upload to register many logs at once, and Excel download to extract a monthly report.",
    "openTripLogList": "Open Trip Log list",
    "openTripLogNew": "New Trip Log",
    "vehicleDriverTitle": "Vehicle / Driver management",
    "vehicleDriverIntro": "Vehicles and drivers referenced by dispatches and trip logs each have their own status.",
    "vehicleStatusBody": "Vehicle status: AVAILABLE · IN_USE · MAINTENANCE · DISPOSED. Use [Change Status] on the vehicle detail page.",
    "driverStatusBody": "Driver status: ACTIVE · ON_LEAVE · INACTIVE. Edit via the ✏️ button on the driver list.",
    "tipsTitle": "Useful tips",
    "tip1": "Use the 🌐 button at the bottom-left of the sidebar to switch language (Korean / English / Vietnamese).",
    "tip2": "The yellow badge next to Dispatch in the sidebar shows pending count; the orange badge next to Monitor shows trips in progress.",
    "tip3": "Trip Logs cannot be edited after VERIFIED — review carefully before verifying.",
    "tip4": "Setting a vehicle to DISPOSED or a driver to INACTIVE prevents them from new dispatches; existing data is preserved."
  },

NODE_ENV=production
PORT=3102

# PostgreSQL 15 + pgvector
DB_HOST=postgres-hscode
DB_PORT=5432
DB_USERNAME=hscode_app
DB_PASSWORD=__change_me__
DB_DATABASE=db_hsm

# Redis (BullMQ)
REDIS_HOST=redis-hscode
REDIS_PORT=6379

# AMA JWT SSO
JWT_SECRET=__change_me__
JWT_ISSUER=ama.amoeba.site
ALLOW_ENTITY_HEADER_AUTH=false

# 설정 암호화 키 (32바이트 권장). 미설정 시 JWT_SECRET 파생
SETTINGS_ENC_KEY=__change_me__

# AI 분류 (Claude). 런타임은 hsm_app_settings가 오버라이드
CLAUDE_API_KEY=
CLAUDE_MODEL_VERSION=claude-sonnet-4-6
AI_DAILY_BUDGET_USD=50

# 임베딩 공급자 (차원은 pgvector 컬럼과 일치해야 함)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024

# 외부 어댑터 토글
ADAPTER_VN_BIEU_THUE_ENABLED=true
ADAPTER_KR_CUSTOMS_ENABLED=true
EXTERNAL_CACHE_TTL_SEC=86400

# POL-001 임계치
THRESHOLD_GAP=0.08
THRESHOLD_REVIEW=0.70
THRESHOLD_FLAG=0.70
MAX_CLARIFY_ROUNDS=5

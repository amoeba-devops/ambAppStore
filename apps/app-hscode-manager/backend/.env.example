NODE_ENV=production
PORT=3102

# PostgreSQL 15 + pgvector
DB_HOST=postgres-hscode
DB_PORT=5432
DB_USERNAME=hscode_app
DB_PASSWORD=__change_me__
DB_DATABASE=db_hsm

# Redis (BullMQ)
REDIS_HOST=redis-hscode
REDIS_PORT=6379

# AMA JWT SSO
JWT_SECRET=__change_me__
JWT_ISSUER=ama.amoeba.site
ALLOW_ENTITY_HEADER_AUTH=false

# 설정 암호화 키 (32바이트 권장). 미설정 시 JWT_SECRET 파생
SETTINGS_ENC_KEY=__change_me__

# AI 분류 (Claude). 런타임은 hsm_app_settings가 오버라이드. 기본=정확도 우선 opus-4-8
# (엑셀 대량 배치는 설정에서 claude-haiku-4-5 / claude-sonnet-5 + 캐싱으로 비용 조정)
CLAUDE_API_KEY=
CLAUDE_MODEL_VERSION=claude-opus-4-8
AI_DAILY_BUDGET_USD=50

# 임베딩 공급자 = BGE-M3 셀프호스트(HuggingFace TEI). 차원은 pgvector 컬럼(1024)과 일치.
EMBEDDING_PROVIDER=bge-m3
# TEI 엔드포인트. 로컬(npm run dev)=로컬 TEI, docker=compose가 http://tei-hscode:80 로 오버라이드.
EMBEDDING_ENDPOINT=http://127.0.0.1:8080
# 외부 API 공급자 사용 시에만 필요(셀프호스트는 비움).
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# CPU TEI(2코어)는 다청크 배치 임베딩이 느림 — 15s면 타임아웃→0 임베딩. 60s 권장.
EMBEDDING_TIMEOUT_MS=60000

# 외부 어댑터 토글
ADAPTER_VN_BIEU_THUE_ENABLED=true
ADAPTER_KR_CUSTOMS_ENABLED=true
EXTERNAL_CACHE_TTL_SEC=86400

# POL-001 임계치
THRESHOLD_GAP=0.08
THRESHOLD_REVIEW=0.70
THRESHOLD_FLAG=0.70
MAX_CLARIFY_ROUNDS=5
